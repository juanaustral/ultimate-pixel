{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate Pixel",
  "version": "0.2.0",
  "identifier": "ar.iona.ultimatepixel",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [{ "title": "Ultimate Pixel", "width": 1280, "height": 720, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Game",
    "shortDescription": "Ultimate frisbee en pixel art",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": { "deb": { "depends": [] } }
  }
}
